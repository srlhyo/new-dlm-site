---
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';
import MesaPosta from '../components/home/MesaPosta.astro';
import Proof from '../components/home/Proof.astro';
import PedirOrcamento from '../components/home/PedirOrcamento.astro';
import salvia from '../assets/img/pal_salvia.jpg';
import bordeaux from '../assets/img/pal_bordeaux.jpg';
import talheres from '../assets/img/value_talheres.jpg';
---
<Base title="Mesa Posta" description="Mesa Posta para casamentos, batizados, aniversários e outras celebrações: toalha, base, loiça, copos, talheres, guardanapo, cartão, flores e luz, montados no local. Lisboa e arredores.">
  <section class="mhero" data-hero aria-labelledby="mp-t">
    <div class="wrap grid">
      <div class="texto-col">
        <p class="ov reveal">Mesa Posta</p>
        <h1 id="mp-t" class="h1 reveal d1">A mesa é a primeira coisa que os convidados veem.</h1>
        <p class="lead reveal d2">Compomos cada lugar peça a peça, para a cor e o tom de cada celebração, e montamos tudo no local antes de alguém chegar. No fim, recolhemos.</p>
        <div class="cta reveal d2"><a href="/pedir-orcamento" class="btn">Pedir orçamento</a><a href="#mesa" class="lnk">Ver a composição <span class="ar">→</span></a></div>
      </div>
      <div class="fotos">
        <Plate src={salvia} alt="Lugar em verde-sálvia, branco e ouro" ratio="2 / 3" class="f1 unveil" priority sizes="(min-width: 1024px) 380px, 60vw" />
        <Plate src={bordeaux} alt="Mesa comprida em bordeaux com velas altas" ratio="2 / 3" class="f2 reveal d2" lift sombra sizes="(min-width: 1024px) 260px, 42vw" />
        <Plate src={talheres} alt="Talheres dourados prontos para a mesa" ratio="1 / 1" class="f3 reveal d3" lift sizes="(min-width: 1024px) 200px, 36vw" />
      </div>
    </div>
  </section>
  <MesaPosta compacto />
  <Proof />
  <PedirOrcamento titulo="Conte-nos como imagina a sua mesa." />
</Base>

<style>
  .mhero { padding-top: clamp(24px, 4vw, 56px); overflow: clip; }
  .grid { display: grid; gap: 32px; }
  .texto-col { display: flex; flex-direction: column; gap: 22px; }
  .h1 { max-width: 14ch; }
  .lead { max-width: 480px; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 26px; }
  .fotos { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .fotos :global(.f1) { grid-column: 1 / span 7; grid-row: 1; }
  .fotos :global(.f2) { grid-column: 6 / span 5; grid-row: 1; margin-top: 45%; z-index: 2; }
  .fotos :global(.f3) { grid-column: 9 / span 4; grid-row: 2; margin-top: -10%; }
  @media (min-width: 1024px) {
    .mhero { padding-top: 0; }
    .grid { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 60px; }
    .texto-col { padding: 96px 0 64px; justify-content: center; }
    .fotos { padding: 48px 0; }
  }
</style>
