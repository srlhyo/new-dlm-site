---
import Plate from '../Plate.astro';
import { Image } from 'astro:assets';
import { CASA, whatsappHref } from '../../data/site.js';
import servir from '../../assets/img/end_servir.jpg';
import pearls from '../../assets/img/pearls.png';
const { titulo = 'Conte-nos sobre o seu evento.', cta = 'Pedir orçamento', foto = servir } = Astro.props;
---
<section class="sec fim" id="pedir" aria-labelledby="fim-t">
  <div class="wrap grid">
    <Plate src={foto} alt="Mão a servir água aromatizada de um dispensador de cristal" ratio="10 / 13" pos="50% 40%" class="foto unveil" sizes="(min-width: 1024px) 400px, 100vw" />
    <div class="conteudo">
      <p class="ov">Pedir orçamento</p>
      <h2 id="fim-t" class="h2">{titulo}</h2>
      <p class="lead">Quatro passos curtos: o tipo de evento, a data e o local, os convidados e os serviços que interessam. Não perguntamos quanto quer gastar. Respondemos com uma proposta, e a conversa continua no WhatsApp.</p>
      <div class="cta">
        <a href="/pedir-orcamento" class="btn">{cta}</a>
        {CASA.whatsapp && <a href={whatsappHref()} class="btn-o" rel="noopener">Falar no WhatsApp</a>}
      </div>
      <p class="texto peq">Sem compromisso.</p>
      <Image src={pearls} alt="" width={72} height={28} class="perolas" aria-hidden="true" />
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 40px; }
  .conteudo { display: flex; flex-direction: column; gap: 20px; }
  .conteudo .h2 { max-width: 14ch; }
  .lead { max-width: 580px; }
  .cta { display: flex; flex-wrap: wrap; gap: 14px; }
  .peq { font-size: 13px; }
  .perolas { width: 72px; height: auto; opacity: 0.9; }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: 400px minmax(0, 1fr); gap: 120px; align-items: center; }
  }
</style>
