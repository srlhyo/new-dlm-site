---
import Plate from '../Plate.astro';
import maos from '../../assets/img/value_maos.jpg';
import bolo from '../../assets/img/value_bolo_carro.jpg';
const passos = [
  ['A primeira conversa', 'Ouvimos a ideia, a data, o local e o número de convidados. E o que o preocupa.'],
  ['A proposta', 'Uma composição à medida, com o que está incluído e o que é opcional. Sem surpresas.'],
  ['Os ajustes', 'Cor, mesa, menu, horários: afinamos em conjunto até estar certo.'],
  ['O dia', 'Chegamos, montamos e, no fim, recolhemos. Ao cliente fica a celebração.'],
];
---
<section class="sec valor" id="como" aria-labelledby="valor-t">
  <div class="wrap grid">
    <div class="fotos">
      <Plate src={maos} alt="Mãos a ajustar o prato num lugar da mesa" ratio="13 / 15" pos="50% 40%" class="unveil" sizes="(min-width: 1024px) 520px, 100vw" />
      <figure class="bastidor reveal d2">
        <Plate src={bolo} alt="Bolo de aniversário transportado ao colo, a caminho do evento" ratio="11 / 13" lift sombra sizes="(min-width: 1024px) 220px, 42vw" />
        <figcaption class="legenda"><span class="cap">Bastidores · o bolo a caminho</span></figcaption>
      </figure>
    </div>
    <div class="conteudo">
      <p class="ov">Acompanhamento</p>
      <h2 id="valor-t" class="h2">Há sempre alguém do outro lado.</h2>
      <p class="texto">O resultado bonito é a parte visível. Antes dele há conversas, decisões e uma montagem que o cliente não tem de gerir. No dia, a equipa chega antes de todos.</p>
      <ol class="passos">
        {passos.map(([t, d], i) => (
          <li><span class="n">{i + 1}</span><div><strong>{t}</strong><p>{d}</p></div></li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 40px; }
  .fotos { position: relative; }
  .bastidor { width: 42%; max-width: 220px; margin: -20% 0 0 auto; position: relative; z-index: 2; padding-right: 8%; }
  .conteudo { display: flex; flex-direction: column; gap: 18px; }
  .conteudo .h2 { max-width: 14ch; }
  .conteudo .texto { max-width: 520px; }
  .passos { margin-top: 16px; display: flex; flex-direction: column; }
  .passos li { display: flex; gap: 22px; padding: 16px 0; border-top: 1px solid var(--borda); }
  .passos .n { font-family: var(--font-display); font-size: 20px; color: var(--ouro-texto); width: 28px; flex: none; line-height: 1.3; }
  .passos strong { display: block; font-weight: 600; font-size: 16px; margin-bottom: 4px; }
  .passos p { font-size: 14px; line-height: 1.55; color: var(--tinta-suave); }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 80px; align-items: start; }
    .bastidor { position: absolute; right: -60px; bottom: -40px; width: 220px; margin: 0; padding: 0; }
  }
</style>
