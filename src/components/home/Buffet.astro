---
import Plate from '../Plate.astro';
import alto from '../../assets/img/buffet_alto.jpg';
import copos from '../../assets/img/buffet_copos.jpg';
import tacas from '../../assets/img/buffet_tacas.jpg';
import brig from '../../assets/img/buffet_brigadeiros.jpg';
import sala from '../../assets/img/buffet_sala.jpg';
---
<section class="sec noite buffet" id="buffet" aria-labelledby="buffet-t">
  <span class="ghost" aria-hidden="true">02</span>
  <div class="wrap z grid">
    <div class="conteudo">
      <p class="ov">Buffet &amp; Catering</p>
      <h2 id="buffet-t" class="h2">Composto em níveis. Servido com calma.</h2>
      <p class="texto">Salgados, doces, saladas e bebidas em mesa própria, com decoração incluída. No Premium, dois elementos de equipa fazem o serviço e a reposição durante o evento.</p>
      <div class="links">
        <a href="#pacotes" class="lnk">Ver os pacotes <span class="ar">→</span></a>
        <a href="/buffet-catering" class="lnk">Ver a página de Buffet &amp; Catering <span class="ar">→</span></a>
      </div>
    </div>
    <div class="niveis" role="group" aria-label="Fotografias do buffet">
      <figure class="n1 reveal"><Plate src={alto} alt="Mesa de buffet noturna com copos de sobremesa em cubos brancos" ratio="3 / 4" pos="50% 40%" lift sizes="(min-width: 1024px) 300px, 48vw" /><figcaption class="legenda"><span class="cap">Mesa de sobremesas</span></figcaption></figure>
      <figure class="n2 reveal d1"><Plate src={copos} alt="Copos de sobremesa com frutos vermelhos" ratio="14 / 15" lift sizes="(min-width: 1024px) 280px, 40vw" /><figcaption class="legenda"><span class="cap">Sobremesas de copo</span></figcaption></figure>
      <figure class="n3 reveal d2"><Plate src={tacas} alt="Taças douradas com molhos" ratio="16 / 11" pos="50% 60%" lift sizes="(min-width: 1024px) 320px, 48vw" /><figcaption class="legenda"><span class="cap">Molhos</span></figcaption></figure>
      <figure class="n4 reveal d3"><Plate src={brig} alt="Brigadeiros em forminhas brancas" ratio="6 / 5" lift sizes="(min-width: 1024px) 240px, 40vw" /><figcaption class="legenda"><span class="cap">Brigadeiros</span></figcaption></figure>
      <figure class="base reveal d3"><Plate src={sala} alt="Sala do buffet com velas e veludo verde" ratio="11 / 2" pos="50% 62%" sizes="(min-width: 1024px) 660px, 100vw" /><figcaption class="legenda"><span class="cap">A sala, ao fim da noite</span></figcaption></figure>
    </div>
  </div>
</section>

<style>
  .buffet { overflow: clip; }
  .grid { display: grid; gap: 48px; }
  .conteudo { display: flex; flex-direction: column; gap: 18px; }
  .conteudo .h2 { max-width: 14ch; }
  .conteudo .texto { max-width: 460px; }
  .links { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; }
  .niveis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: end; }
  .n2 { margin-top: 24%; }
  .n3 { margin-top: -10%; }
  .base { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 80px; align-items: start; }
    .niveis { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 24px; align-items: start; }
    .n1 { grid-column: 1 / span 6; grid-row: 1; margin: 0; }
    .n2 { grid-column: 8 / span 5; grid-row: 1; margin-top: 100px; }
    .n3 { grid-column: 2 / span 6; grid-row: 2; margin-top: 40px; }
    .n4 { grid-column: 9 / span 4; grid-row: 2; margin-top: 80px; }
    .base { grid-column: 1 / -1; grid-row: 3; margin-top: 40px; }
  }
</style>
