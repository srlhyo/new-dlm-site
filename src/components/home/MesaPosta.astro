---
import { Image } from 'astro:assets';
import conjunto from '../../assets/img/mesa_conjunto.jpg';
import detalhe from '../../assets/img/mesa_detalhe.jpg';
const camadas = ['Toalha e base', 'Loiça e sousplat', 'Copos', 'Talheres', 'Guardanapo e cartão', 'Flores e velas'];
const { compacto = false } = Astro.props;
---
<section class="sec mesa" id="mesa" aria-labelledby="mesa-t" data-focus data-focus-ativo="conjunto">
  <span class="ghost" aria-hidden="true">01</span>
  <div class="wrap z">
    <div class="sec-head">
      <div><p class="ov">Mesa Posta</p><h2 id="mesa-t" class="h2">Uma mesa composta peça a peça.</h2></div>
      <p class="texto">Toalha, base, loiça, copos, talheres, guardanapo, cartão, flores e luz, escolhidos para cada celebração e montados por nós, no local, antes de alguém chegar.</p>
    </div>
    <div class="palco">
      <figure class="grande plate unveil">
        <Image src={conjunto} alt="Mesa comprida de casamento em bordeaux e branco, com velas" widths={[720, 1080, 1440, 1800]} sizes="(min-width: 1024px) 860px, 100vw" style="object-position:50% 55%" class="v-conjunto" />
        <Image src={detalhe} alt="Sousplat dourado, guardanapo e cartão de agradecimento" widths={[720, 1080, 1440]} sizes="(min-width: 1024px) 860px, 100vw" class="v-detalhe" loading="lazy" />
      </figure>
      <div class="camadas reveal d1">
        <p class="cap">A composição de um lugar</p>
        <ol>{camadas.map((c, i) => <li><span>{c}</span><span class="cap num-c">0{i + 1}</span></li>)}</ol>
      </div>
      <button type="button" class="pequeno plate lift sombra reveal d2" data-focus-troca aria-label="Trocar o foco entre o conjunto e o detalhe">
        <Image src={detalhe} alt="" widths={[420, 720, 1080]} sizes="(min-width: 1024px) 400px, 56vw" class="v-conjunto" loading="lazy" />
        <Image src={conjunto} alt="" widths={[420, 720, 1080]} sizes="(min-width: 1024px) 400px, 56vw" class="v-detalhe" loading="lazy" style="object-position:50% 55%" />
      </button>
      <div class="controlo reveal d2">
        <div role="group" aria-label="Foco" class="seg">
          <button type="button" class="pill" data-focus-alvo="conjunto" aria-pressed="true">Conjunto</button>
          <button type="button" class="pill" data-focus-alvo="detalhe" aria-pressed="false">Detalhe</button>
        </div>
        <p class="texto">Toque ou passe o rato: o foco muda do conjunto para o lugar.</p>
      </div>
      <div class="legenda reveal d3"><span class="cap">Casamento · bordeaux e branco</span><p>Mesa comprida, velas altas, sousplats dourados.</p></div>
    </div>
    {!compacto && <a href="/mesa-posta" class="lnk mais">Ver Mesa Posta <span class="ar">→</span></a>}
  </div>
</section>

<style>
  .mesa { overflow: clip; }
  .palco { position: relative; display: grid; gap: 24px; }
  .grande { order: 1; } .pequeno { order: 2; } .controlo { order: 3; } .legenda { order: 4; } .camadas { order: 5; margin-top: 8px; }
  .grande { aspect-ratio: 43 / 28; }
  .plate :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.32s var(--ease); }
  .plate :global(.v-detalhe) { opacity: 0; }
  [data-focus-ativo="detalhe"] .plate :global(.v-detalhe) { opacity: 1; }
  [data-focus-ativo="detalhe"] .plate :global(.v-conjunto) { opacity: 0; }
  .pequeno { width: 56%; max-width: 400px; aspect-ratio: 10 / 11; margin: -24% 0 0 auto; position: relative; z-index: 2; display: block; padding: 0; border: 0; }
  .camadas .cap { margin-bottom: 10px; }
  .camadas li { display: flex; justify-content: space-between; align-items: center; min-height: 42px; border-top: 1px solid var(--borda); font-size: 15px; }
  .camadas ol { border-bottom: 1px solid var(--borda); }
  .num-c { color: var(--ouro-texto); }
  .controlo { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .controlo .texto { font-size: 13px; }
  .seg { display: inline-flex; border: 1.5px solid var(--ouro-suave); border-radius: 999px; padding: 3px; background: var(--papel); }
  .seg .pill { border: 0; background: transparent; min-height: 44px; }
  .seg .pill[aria-pressed="true"] { background: var(--ouro); }
  .mais { margin-top: 32px; }
  @media (min-width: 1024px) {
    .palco { grid-template-columns: minmax(0, 860fr) minmax(0, 360fr); column-gap: 60px; row-gap: 0; padding-bottom: 40px; }
    .grande { grid-column: 1; grid-row: 1; aspect-ratio: 43 / 28; }
    .grande, .pequeno, .controlo, .legenda, .camadas { order: 0; }
    .camadas { grid-column: 2; grid-row: 1; margin-top: 0; align-self: start; }
    .pequeno { position: absolute; right: 0; bottom: 0; width: min(400px, 34%); margin: 0; aspect-ratio: 10 / 11; z-index: 2; }
    .controlo { grid-column: 1; grid-row: 2; margin-top: 28px; max-width: 60%; }
    .legenda { grid-column: 1; grid-row: 3; margin-top: 20px; max-width: 60%; }
    .mais { margin-top: 48px; }
  }
</style>
