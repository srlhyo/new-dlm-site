---
// Ícones de linha fina (viewBox 24, stroke 1.5, sem preenchimento),
// como manda o design system. Herdam a cor do texto.
const { name, size = 18 } = Astro.props;
const paths = {
  whatsapp: '<path d="M4 20l1.3-3.9A8 8 0 1 1 8.2 19.1L4 20z"/><path d="M9.5 9.5c.2 1.6 1.7 3.4 3.4 4.2l1.2-1.1 1.9.9c-.2 1.2-1.1 1.8-2.2 1.6-2.6-.5-5.3-3.2-5.9-5.9-.2-1.1.4-2 1.6-2.2l.9 1.9-.9.6z"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  heart: '<path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 7.9 3.6 4.5 7 4.5c2 0 3.4 1.2 5 3 1.6-1.8 3-3 5-3 3.4 0 5.6 3.4 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2z"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>',
  play: '<path d="M7 5l12 7-12 7z"/>',
  minus: '<path d="M6 12h12"/>',
  plus: '<path d="M12 6v12M6 12h12"/>',
};
const strokeWidth = name === 'check' ? 2 : 1.5;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
